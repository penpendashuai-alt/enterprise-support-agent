# API keys for different providers
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
USE_AWS_BEDROCK=false

#Vertex AI
GOOGLE_APPLICATION_CREDENTIALS=

# Amazon Bedrock Knowledge Base ID
AWS_KB_ID="<knowledge-base-id>"

# Use a fake model for testing
USE_FAKE_MODEL=false

# Set a default model
DEFAULT_MODEL=

# If MODEL is set to "openai-compatible", set the following
# This is just a flexible solution. If you need multiple model options, you still need to add it to models.py
COMPATIBLE_MODEL=
COMPATIBLE_API_KEY=
COMPATIBLE_BASE_URL=

# Web server configuration
HOST=0.0.0.0
PORT=8080

# Authentication secret, HTTP bearer token header is required if set.
# WARNING: If unset, all API endpoints are unauthenticated. Always set this in production.
AUTH_SECRET=

# Langsmith configuration
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=default
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Application mode. If the value is "dev", it will enable uvicorn reload
MODE=

# Database type.
# If the value is "postgres", then it will require Postgresql related environment variables.
# If the value is "sqlite", then you can configure optional file path via SQLITE_DB_PATH
DATABASE_TYPE=postgres

# If DATABASE_TYPE=sqlite (Optional)
SQLITE_DB_PATH=

# If DATABASE_TYPE=postgres
# Phase 6 host application + compose.postgres.yaml; migrate before startup.
# Inside the same Compose network, use postgres:5432 instead.
POSTGRES_USER=support_demo
POSTGRES_PASSWORD=replace-with-local-development-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_DB=enterprise_support
POSTGRES_POOL_TIMEOUT=10
POSTGRES_CONNECT_TIMEOUT=5
POSTGRES_STATEMENT_TIMEOUT_MS=10000
POSTGRES_POOL_MAX_WAITING=20
SUPPORT_DEMO_SAMPLES=false

# you will be able to identify AST connections in Postgres Connection Manager under this Application Name
# POSTGRES_APPLICATION_NAME = "agent-service-toolkit"
# Saver, Store and business repository have independent pools (three per worker).
# Support Agent execution locking supports one worker only.
# POSTGRES_MIN_CONNECTIONS_PER_POOL=1
# POSTGRES_MAX_CONNECTIONS_PER_POOL= 3

# If DATABASE_TYPE=mongo
# See docker/compose.mongo.yaml for a local Mongo container to test against
MONGO_HOST=
MONGO_PORT=
MONGO_DB=
# MONGO_USER=
# MONGO_PASSWORD=
# MONGO_AUTH_SOURCE=
# MONGO_TLS=false

# OpenWeatherMap API key
OPENWEATHERMAP_API_KEY=

# Add for running ollama
# OLLAMA_MODEL=llama3.2
# Note: set OLLAMA_BASE_URL if running service in docker and ollama on bare metal
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Add for running Azure OpenAI
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_DEPLOYMENT_MAP={"gpt-5": "gpt-5-deployment", "gpt-5-mini": "gpt-5-mini-deployment"}

# Agent URL: used in Streamlit app - if not set, defaults to http://{HOST}:{PORT}
# AGENT_URL=http://localhost:8080

# LANGFUSE Configuration
#LANGFUSE_TRACING=true
#LANGFUSE_PUBLIC_KEY=pk-...
#LANGFUSE_SECRET_KEY=sk-lf-....
#LANGFUSE_HOST=http://localhost:3000

# GitHub MCP Agent Configuration
# GitHub Personal Access Token (required for GitHub MCP server)
# If not set, the GitHub MCP agent will have no tools
GITHUB_PAT=

# Voice Features (Optional)
# NOTE: Voice features are configured on the client (Streamlit app) side, not the server (API).
# Requires OPENAI_API_KEY to be set (see above).
# Set provider name to enable voice input/output. Leave empty to disable.
VOICE_STT_PROVIDER=        # Speech-to-text provider (only 'openai' supported currently)
VOICE_TTS_PROVIDER=        # Text-to-speech provider (only 'openai' supported currently)

# Separate local demonstration ticket store (single service process).
TICKET_DB_PATH=tickets.db


QDRANT_URL=https://YOUR-CLUSTER.REGION.cloud.qdrant.io:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=enterprise_support_dense_v2
QDRANT_VECTOR_SIZE=1024
QDRANT_DISTANCE=cosine
QDRANT_TIMEOUT=30

EMBED_MODEL_TYPE=dashscope
EMBED_MODEL_NAME=text-embedding-v3
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_API_KEY=
EMBED_DIMENSIONS=1024
EMBED_BATCH_SIZE=10
EMBED_TIMEOUT=30

# Dense retrieval baseline; score is similarity, not probability.
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=5
RAG_MIN_SCORE=0.65
RAG_CONTEXT_CHARS=4500
RAG_SNIPPET_CHARS=1000
RAG_TIMEOUT=90

# Phase 5 dev-selected Dense20 profile. Build the v2 snapshot before use.
# For Phase 4: collection enterprise_support_dense_v1 and RAG_DENSE_LEGACY=true.
# Dense remains usable without ES or reranker keys.
RAG_RETRIEVAL_MODE=dense
RAG_DENSE_LEGACY=false
RAG_DENSE_CANDIDATES=20
RAG_BM25_CANDIDATES=20
RAG_FINAL_K=5
RAG_RRF_C=60
RAG_DENSE_THRESHOLD=0.65
RAG_BM25_THRESHOLD=8
RAG_RRF_THRESHOLD=0
RAG_RERANK_THRESHOLD=0.3
RAG_ALLOW_FALLBACK=false
ES_URL=http://127.0.0.1:19200
ES_API_KEY=
ES_INDEX=enterprise-support-lexical-v2
ES_TIMEOUT=10
ES_TITLE_BOOST=2
RERANK_PROVIDER=dashscope
RERANK_MODEL=gte-rerank-v2
RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_API_KEY=
# Enable only after confirming the embedding workspace also grants reranking access.
RERANK_USE_EMBED_KEY=false
RERANK_TIMEOUT=20
RERANK_MAX_CANDIDATES=40

# Phase 7: start local Redis before enabling. Single application worker only.
RAG_CACHE_ENABLED=false
ADMISSION_ENABLED=false
REDIS_URL=redis://127.0.0.1:16379/0
REDIS_NAMESPACE=esa:p7
REDIS_TIMEOUT=0.5
REDIS_POOL_SIZE=24
RAG_CACHE_TTL=300
RAG_CACHE_MAX_BYTES=262144
RETRIEVAL_INFLIGHT_MAX=8
RETRIEVAL_WAITERS_MAX=32
SHARED_RETRIEVAL_TIMEOUT=90
REQUEST_TIMEOUT=120
EXECUTION_LIMIT=6
EXECUTION_QUEUE_LIMIT=12
PROTECTED_LIMIT=3
PROTECTED_QUEUE_LIMIT=8
READ_LIMIT=4
READ_QUEUE_LIMIT=8
MODEL_LIMIT=3
QUEUE_WAIT_TIMEOUT=3
THREAD_WAIT_TIMEOUT=2
RATE_SERVICE_CAPACITY=40
RATE_SERVICE_REFILL=20
RATE_USER_CAPACITY=20
RATE_USER_REFILL=10
