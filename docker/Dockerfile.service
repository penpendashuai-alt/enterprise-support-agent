FROM python:3.13.14-slim
WORKDIR /app
ENV UV_PROJECT_ENVIRONMENT=/usr/local/ UV_COMPILE_BYTECODE=1 UV_NO_CACHE=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/app/src
COPY pyproject.toml uv.lock ./
RUN pip install --no-cache-dir uv==0.12.5 && uv sync --frozen --no-install-project --no-dev
RUN useradd --create-home --uid 10001 app && mkdir /app/data && chown app:app /app/data
COPY src/ ./src/
COPY scripts/ ./scripts/
COPY migrations/ ./migrations/
COPY data/knowledge/ ./data/knowledge/
COPY evaluation/datasets/snapshot_v2.json ./evaluation/datasets/
USER 10001:10001
CMD ["python", "src/run_service.py"]
