# Copy to .env.compose; use --env-file .env.compose for interpolation too.
ESA_ENV_FILE=.env.compose
AUTH_SECRET=replace-with-a-random-shared-key
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_USER=support_demo
POSTGRES_DB=enterprise_support
REDIS_MAXMEMORY=64mb
REDIS_CONTAINER_MEMORY=128m
CODE_VERSION=local
COMPATIBLE_BASE_URL=https://your-provider.example/v1
COMPATIBLE_MODEL=your-configured-model
COMPATIBLE_API_KEY=replace-with-provider-key
DEFAULT_MODEL=openai-compatible
QDRANT_URL=https://your-cluster.example
QDRANT_API_KEY=replace-with-qdrant-key
QDRANT_COLLECTION=enterprise_support_dense_v2
EMBED_API_KEY=replace-with-embedding-key
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
LOCAL_QDRANT_COLLECTION=enterprise_support_dense_local_v2
LANGFUSE_TRACING=false
